{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent2plugin 插件明细",
  "description": "每个插件一份，网关据此拼出各平台的下载地址。",
  "type": "object",
  "required": ["id", "name", "version", "protocol", "release", "platforms", "providers"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "包 id，必须与 index.json 里的条目一致"
    },
    "name": { "type": "string", "description": "显示名" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+",
      "description": "语义化版本"
    },
    "protocol": {
      "type": "integer",
      "const": 1,
      "description": "插件协议版本，必须等于网关的 PROTOCOL_VERSION"
    },
    "description": { "type": "string" },
    "homepage": { "type": "string", "description": "项目主页" },
    "license": { "type": "string", "description": "SPDX 标识" },
    "official": { "type": "boolean" },
    "release": {
      "type": "object",
      "required": ["repo", "tag", "asset"],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$",
          "description": "包所在的仓库 owner/repo"
        },
        "tag": {
          "type": "string",
          "description": "Release tag 模板，需含 {version}。同一仓库放多个插件时用前缀区分（如 demo-v{version}）"
        },
        "asset": {
          "type": "string",
          "description": "资产名模板，需含 {id}、{version}、{target}。资产名必须逐字匹配"
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "x86_64-pc-windows-msvc",
          "x86_64-apple-darwin",
          "aarch64-apple-darwin",
          "x86_64-unknown-linux-gnu",
          "aarch64-unknown-linux-gnu"
        ]
      },
      "description": "这个包提供了哪些平台的二进制"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "provider id，与代码里的 ID 常量一致" },
          "label": { "type": "string", "description": "界面显示名" },
          "order": { "type": "integer", "description": "排序权重" },
          "default_enabled": {
            "type": "boolean",
            "description": "装好后是否默认启用这一家"
          }
        }
      }
    }
  }
}
